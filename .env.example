# ---------------------------------------------------------------------------
# telegram-nft-gate: example configuration
#
# Copy to `.dev.vars` for local development (`wrangler dev` reads it).
# In production these are Cloudflare secrets: `wrangler secret put <NAME>`.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Telegram --------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The private group's chat id. Supergroups are negative and start with -100.
#
# Optional. Leave unset and instead add the bot to your group as admin: it
# will detect that and DM your admins (ADMIN_TELEGRAM_IDS) to confirm via
# /setup. A value set here is only the initial default: confirming a group
# through /setup always takes precedence over this.
# TELEGRAM_GROUP_ID=-1001234567890

# Random string you also pass as `secret_token` when calling setWebhook.
# Required: the webhook rejects every update (503) until this is set, because
# without it anyone who guesses your webhook URL could post fake updates.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# --- NFT collection --------------------------------------------------------

# The canonical on-chain certified collection id (base58).
#
# NOT a marketplace slug, collection name, symbol, creator address, candy
# machine address, or an individual NFT mint. Validate it before going live:
#   pnpm run validate:collection <mintA> <mintB> <mintC>
#
# The example below is Solana Business Frogs, the initial reference deployment.
# Replace it with your own collection's id.
NFT_COLLECTION_ID=J7rxtKmEpNJEtrfkagiTF1gsmLyVus6BQZFY4ouBkeMG

# --- Helius ----------------------------------------------------------------

# https://dashboard.helius.dev. This is server-side only and is never sent to
# the browser.
#
# Required unless DAS_ENDPOINT below points at a different DAS-compatible
# provider. There is no unauthenticated fallback: startup fails rather than
# silently running ownership checks against a rate-limited, no-SLA endpoint.
HELIUS_API_KEY=your-helius-api-key

# Optional: point ownership queries at a specific DAS-compatible RPC endpoint
# instead of the Helius/public-RPC default above. Rarely needed.
# DAS_ENDPOINT=https://your-das-compatible-endpoint

# --- Admin -----------------------------------------------------------------

# Comma-separated Telegram numeric user ids allowed to run admin bot commands
# (/adminstats, /adminusers, /adminrecheck, /adminrevoke, /adminrestore).
ADMIN_TELEGRAM_IDS=11111111,22222222

# Signs verification links sent by /verify. Rotate to invalidate every
# outstanding link. Use at least 32 random characters.
SESSION_SECRET=generate-a-long-random-string

# --- Behaviour -------------------------------------------------------------
#
# For a Git-connected deploy, set these as plain (non-secret) values in the
# Cloudflare dashboard's "Variables and secrets" screen, NOT in wrangler.jsonc.
# That file has no `vars` block on purpose, since Cloudflare's Git-integration
# deploys would silently overwrite dashboard-set values with whatever is
# checked into the repo on every push. Every value below has a safe default in
# src/env.ts if left unset entirely.

# Shown in bot messages, e.g. "Welcome to <APP_NAME>".
# Not a secret. Rename this to your community/deployment, e.g. "SBF Cabal".
APP_NAME=telegram-nft-gate

# Hours a user keeps access after ownership is lost, before removal.
ACCESS_GRACE_PERIOD_HOURS=24

# While true, members who were already in the group are never auto-removed.
# Set to false to begin enforcement once migration is complete.
MIGRATION_MODE=true

# Lifetime of a signing challenge, in seconds.
CHALLENGE_TTL_SECONDS=300

# Scheduled recheck tuning.
RECHECK_BATCH_SIZE=100
RECHECK_INTERVAL_HOURS=12

# Public origin of the deployed Worker. Optional: inferred per-request when
# unset, but required for links generated by the cron job.
PUBLIC_BASE_URL=https://your-worker.example.workers.dev
