{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-nft-gate",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // The React/Vite frontend is served by THIS Worker. No Cloudflare Pages.
  // `run_worker_first` keeps API + webhook paths off the static-asset fast path.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-nft-gate",
      // Replace with your own database id from `wrangler d1 create telegram-nft-gate`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      // Replace with your own namespace id from `wrangler kv namespace create KV`.
      "id": "00000000000000000000000000000000"
    }
  ],

  // Scheduled ownership re-checks. Adjust to taste; hourly is a sane default.
  "triggers": { "crons": ["0 * * * *"] },

  // Deliberately no "vars" block here. APP_NAME, ACCESS_GRACE_PERIOD_HOURS,
  // MIGRATION_MODE, CHALLENGE_TTL_SECONDS, RECHECK_BATCH_SIZE and
  // RECHECK_INTERVAL_HOURS are operator config, not application defaults, and
  // don't belong checked into a repo other communities will fork.
  //
  // Wrangler's actual default is to treat this file as authoritative for the
  // Worker's ENTIRE var set: on every `wrangler deploy`, anything set in the
  // dashboard but NOT declared here gets silently deleted, not merely left
  // alone. `keep_vars: true` is what disables that — without it, this repo
  // having no vars block would wipe every var on the next deploy, exactly the
  // opposite of the intent above.
  //
  // Set these through:
  //   - the Cloudflare dashboard, for a deployment connected to Git, or
  //   - `.dev.vars` (copy from .env.example), for local `wrangler dev`.
  // Every one of them has a safe fallback in src/env.ts if left unset entirely.
  "keep_vars": true
}
